# Xdigitex Pay credentials stay on the server. Never add them to app.js or HTML.
XDIGITEX_PAY_API_KEY=
XDIGITEX_PAY_BASE_URL=https://pay.xdigitex.space/api

# Public HTTPS origin so Xdigitex Pay can call the webhook and return customers.
PUBLIC_BASE_URL=
COOKIE_SECURE=false

# Optional read-only FX reference data. This key does not enable trade execution.
TWELVE_DATA_API_KEY=
MARKET_DATA_CACHE_SECONDS=600
